\f0\fs24 \cf0 From d333c1d76ba0d2d1e5472ab18c7c57de32ed99af Mon Sep 17 00:00:00 2001\
From: Claude <noreply@anthropic.com>\
Date: Mon, 6 Apr 2026 12:36:21 +0000\
Subject: [PATCH] Add Unity project bootstrap and fix test asmdef compilation\
MIME-Version: 1.0\
Content-Type: text/plain; charset=UTF-8\
Content-Transfer-Encoding: 8bit\
\
The EditModeTests asmdef referenced no other assemblies, so the 75 NUnit\
tests could not see any Matchmancer.* runtime types \'97 they would have\
failed to compile on the user's first Test Runner pass. Introduce a\
Matchmancer.Runtime asmdef rooted at Assets/Scripts and have the test\
asmdef reference it.\
\
Also add the minimum scaffolding (Packages/manifest.json,\
ProjectSettings/ProjectVersion.txt, Unity .gitignore) so Unity Hub can\
open the folder as a 2022.3 LTS project. Scene and prefab creation\
remains a manual Editor step.\
---\
 .gitignore                                 | 66 ++++++++++++++++++++++\
 Assets/Scripts/Matchmancer.Runtime.asmdef  | 14 +++++\
 Assets/Tests/EditMode/EditModeTests.asmdef |  8 +--\
 Packages/manifest.json                     | 10 ++++\
 ProjectSettings/ProjectVersion.txt         |  2 +\
 5 files changed, 95 insertions(+), 5 deletions(-)\
 create mode 100644 Assets/Scripts/Matchmancer.Runtime.asmdef\
 create mode 100644 Packages/manifest.json\
 create mode 100644 ProjectSettings/ProjectVersion.txt\
\
diff --git a/.gitignore b/.gitignore\
index 56526d0..c1ca6e6 100644\
--- a/.gitignore\
+++ b/.gitignore\
@@ -1,2 +1,68 @@\
 .superpowers/\
 .DS_Store\
+\
+# Unity (https://github.com/github/gitignore/blob/main/Unity.gitignore)\
+/[Ll]ibrary/\
+/[Tt]emp/\
+/[Oo]bj/\
+/[Bb]uild/\
+/[Bb]uilds/\
+/[Ll]ogs/\
+/[Uu]ser[Ss]ettings/\
+\
+# MemoryCaptures can get excessive in size.\
+/[Mm]emoryCaptures/\
+\
+# Recordings can get excessive in size\
+/[Rr]ecordings/\
+\
+# Autogenerated Jetbrains Rider plugin\
+/[Aa]ssets/Plugins/Editor/JetBrains*\
+\
+# Visual Studio cache directory\
+.vs/\
+\
+# Gradle cache directory\
+.gradle/\
+\
+# Autogenerated VS/MD/Consulo solution and project files\
+ExportedObj/\
+.consulo/\
+*.csproj\
+*.unityproj\
+*.sln\
+*.suo\
+*.tmp\
+*.user\
+*.userprefs\
+*.pidb\
+*.booproj\
+*.svd\
+*.pdb\
+*.mdb\
+*.opendb\
+*.VC.db\
+\
+# Unity3D generated meta files\
+*.pidb.meta\
+*.pdb.meta\
+*.mdb.meta\
+\
+# Unity3D generated file on crash reports\
+sysinfo.txt\
+\
+# Builds\
+*.apk\
+*.aab\
+*.unitypackage\
+*.app\
+\
+# Crashlytics generated file\
+crashlytics-build.properties\
+\
+# Packed Addressables\
+/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*\
+\
+# Temporary auto-generated Android Assets\
+/[Aa]ssets/[Ss]treamingAssets/aa.meta\
+/[Aa]ssets/[Ss]treamingAssets/aa/*\
diff --git a/Assets/Scripts/Matchmancer.Runtime.asmdef b/Assets/Scripts/Matchmancer.Runtime.asmdef\
new file mode 100644\
index 0000000..7223c8f\
--- /dev/null\
+++ b/Assets/Scripts/Matchmancer.Runtime.asmdef\
@@ -0,0 +1,14 @@\
+\{\
+    "name": "Matchmancer.Runtime",\
+    "rootNamespace": "Matchmancer",\
+    "references": ["Unity.TextMeshPro"],\
+    "includePlatforms": [],\
+    "excludePlatforms": [],\
+    "allowUnsafeCode": false,\
+    "overrideReferences": false,\
+    "precompiledReferences": [],\
+    "autoReferenced": true,\
+    "defineConstraints": [],\
+    "versionDefines": [],\
+    "noEngineReferences": false\
+\}\
diff --git a/Assets/Tests/EditMode/EditModeTests.asmdef b/Assets/Tests/EditMode/EditModeTests.asmdef\
index b3d1c52..a683306 100644\
--- a/Assets/Tests/EditMode/EditModeTests.asmdef\
+++ b/Assets/Tests/EditMode/EditModeTests.asmdef\
@@ -1,7 +1,7 @@\
 \{\
     "name": "EditModeTests",\
     "rootNamespace": "",\
-    "references": [],\
+    "references": ["Matchmancer.Runtime"],\
     "includePlatforms": [\
         "Editor"\
     ],\
@@ -12,9 +12,7 @@\
         "nunit.framework.dll"\
     ],\
     "autoReferenced": false,\
-    "defineConstraints": [\
-        "UNITY_INCLUDE_TESTS"\
-    ],\
+    "defineConstraints": [],\
     "versionDefines": [],\
-    "noEngineReferences": true\
+    "noEngineReferences": false\
 \}\
diff --git a/Packages/manifest.json b/Packages/manifest.json\
new file mode 100644\
index 0000000..e64dda3\
--- /dev/null\
+++ b/Packages/manifest.json\
@@ -0,0 +1,10 @@\
